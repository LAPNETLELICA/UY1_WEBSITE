# Public Supabase project values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin. Set this before building; it is used by metadata,
# sitemap, robots, and as a fallback for server-side invitation redirects.
NEXT_PUBLIC_SITE_URL=https://sciences.example.edu

# Server-only canonical origin. Prefer this for invitation redirects because it
# is resolved at runtime and is never bundled into browser JavaScript.
SITE_URL=https://sciences.example.edu

# Server-only Supabase admin credential. Use only one of these; never prefix it
# with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me_only_for_legacy_projects
